# Production Environment Configuration
# This file should be customized for production deployment

# API Configuration - Production Server
VITE_API_BASE_URL=https://your-api-domain.com/api
VITE_UPLOAD_URL=https://your-api-domain.com/uploads

# Application Configuration
VITE_APP_NAME=Blog Admin Panel
VITE_APP_VERSION=1.0.0

# Authentication Configuration - Production
# ⚠️ IMPORTANT: Change this secret key for production!
VITE_JWT_SECRET=your-production-jwt-secret-key
VITE_JWT_EXPIRES_IN=7d

# Production Configuration
VITE_DEBUG=false
VITE_LOG_LEVEL=error

# Feature Flags - Production
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_MOCK_DATA=false
VITE_ENABLE_DEV_TOOLS=false

# Production API Settings
VITE_API_TIMEOUT=5000
VITE_ENABLE_API_MOCKING=false

# Production Optimizations
VITE_ENABLE_PWA=true
VITE_ENABLE_COMPRESSION=true
VITE_ENABLE_CACHING=true
