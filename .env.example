# Environment Configuration for Blog Admin Panel

# API Configuration
VITE_API_BASE_URL=http://localhost:3001/api
VITE_UPLOAD_URL=http://localhost:3001/uploads

# Application Configuration
VITE_APP_NAME=Blog Admin Panel
VITE_APP_VERSION=1.0.0

# Authentication Configuration
VITE_JWT_SECRET=your-jwt-secret-key-change-in-production
VITE_JWT_EXPIRES_IN=7d

# Development Configuration
VITE_DEBUG=true
VITE_LOG_LEVEL=debug

# Feature Flags
VITE_ENABLE_ANALYTICS=true
VITE_ENABLE_REAL_TIME=true
VITE_ENABLE_THEME_TOGGLE=true

# Third-party Services (optional)
# VITE_GOOGLE_ANALYTICS_ID=
# VITE_SENTRY_DSN=
# VITE_CLOUDINARY_CLOUD_NAME=
