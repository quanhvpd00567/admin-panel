# Development Environment Configuration
# Copy this file to .env.local for local development

# API Configuration - Development Server (Learning Management Backend)
VITE_API_BASE_URL=http://localhost:3333/api/v1
VITE_UPLOAD_URL=http://localhost:3333/uploads

# Application Configuration
VITE_APP_NAME=Blog Admin Panel (Dev)
VITE_APP_VERSION=1.0.0-dev

# Authentication Configuration - Development
VITE_JWT_SECRET=dev-jwt-secret-key-not-for-production
VITE_JWT_EXPIRES_IN=24h

# Development Configuration
VITE_DEBUG=false
VITE_LOG_LEVEL=debug

# Feature Flags - Development
VITE_ENABLE_ANALYTICS=false
VITE_ENABLE_MOCK_DATA=true
VITE_ENABLE_DEV_TOOLS=true

# Development API Settings
VITE_API_TIMEOUT=10000
VITE_ENABLE_API_MOCKING=true

# Development UI Settings
VITE_SHOW_GRID_OVERLAY=false
VITE_SHOW_COMPONENT_OUTLINES=false
